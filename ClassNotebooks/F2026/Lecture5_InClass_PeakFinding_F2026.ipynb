    },
    {
      "cell_type": "markdown",
      "source": [
        "I have labeled all of the mystery spectra as \"A\", \"B\", \"C\", etc. This is a quick bit of code to generate a list of them for you."
      ],
      "metadata": {
        "id": "SHpDmCVjmPs6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import string\n",
        "label_letters = list(string.ascii_uppercase[:16])\n",
        "print(f'The generated list is {label_letters}')"
      ],
      "metadata": {
        "id": "vJuV2M0qmFa_"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Then, you can autoloop through all of them with a for loop:"
      ],
      "metadata": {
        "id": "E9BUBoTUmpNm"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "fig, ax = plt.subplots()\n",
        "pcol = iter(cm.rainbow(np.linspace(0,1,len(label_letters))))\n",
        "for l in label_letters: # goes through each\n",
        "  data = pd.read_csv(f'{mysterypath}{l}.csv',skiprows=15,header=None,names=['wavenumber','intensity'])\n",
        "  data.insert(2, \"Abs\", np.log10(1/data['intensity']))\n",
        "  ax.plot(data['wavenumber'],data['Abs'],label=l,color=next(pcol))\n",
        "\n",
        "ax.set_xlabel('Wavenumber (cm$^{-1}$)')\n",
        "ax.set_ylabel('Absorbance')\n",
        "ax.legend(ncol=2)\n",
        "ax.set_xlim(4000,400)"
      ],
      "metadata": {
        "id": "2_cQJQgCmYF-"
      },
      "execution_count": null,
      "outputs": []
