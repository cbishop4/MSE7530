    },
    {
      "cell_type": "code",
      "source": [
        "fig, ax = plt.subplots(1,2,figsize=(10,3))\n",
        "\n",
        "ax[0].plot(pol1['wavenumber'],pol1['intensity'],label='1')\n",
        "ax[0].plot(pol2['wavenumber'],pol2['intensity'],label='2')\n",
        "ax[0].plot(pol3['wavenumber'],pol3['intensity'],label='3')\n",
        "ax[0].set_ylabel('Intensity')\n",
        "\n",
        "ax[1].plot(pol1['wavenumber'],pol1['Abs'],label='1')\n",
        "ax[1].plot(pol2['wavenumber'],pol2['Abs'],label='2')\n",
        "ax[1].plot(pol3['wavenumber'],pol3['Abs'],label='3')\n",
        "ax[1].set_ylabel('Absorbance')\n",
        "\n",
        "for a in ax:\n",
        "  a.set_xlabel('Wavenumber (cm$^{-1}$)')\n",
        "  a.set_xlim(4000,400) # modify this if you want to zoom in to something\n",
